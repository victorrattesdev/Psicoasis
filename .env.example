# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/psicoasis?schema=public"

# Secret para assinar JWTs de usuário — OBRIGATÓRIO em produção
# Gere um valor aleatório, ex: openssl rand -hex 32
JWT_SECRET="um-segredo-aleatorio-longo-para-jwt"

# Admin credentials — defina valores fortes em produção
ADMIN_EMAIL="admin@seudominio.com"
ADMIN_PASSWORD="senha-forte-aqui"
ADMIN_NAME="Administrador"

# Secret para proteger o endpoint de criação do admin
# Gere um valor aleatório, ex: openssl rand -hex 32
ADMIN_INIT_SECRET="um-segredo-aleatorio-longo"
